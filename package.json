{
  "name": "ai-tms-riderapp-playwright-e2e-tests",
  "version": "1.0.0",
  "description": "Playwright E2E tests for TMS Rider Web App",
  "scripts": {
    "test": "npx playwright test",
    "test:rider": "npx playwright test --project=rider-chromium",
    "test:rider:staging": "ENV=staging npx playwright test --project=rider-chromium",
    "test:rider:preprod": "ENV=preproduction npx playwright test --project=rider-chromium",
    "test:rider:prod": "ENV=production npx playwright test --project=rider-chromium",
    "test:asap": "npx playwright test --project=rider-chromium tests/on-demand/asap-only/",
    "test:smoke": "npx playwright test --grep @smoke",
    "report": "npx playwright show-report",
    "report:dashboard": "npx tsx helpers/generate-report.ts && open dashboard-report.html || xdg-open dashboard-report.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "typescript": "^6.0.2"
  }
}
